#jinja2: lstrip_blocks: True
{# Each zone's wildcard certificate (parent domain of a host, or the bare domain itself) is requested by the
   first router that serves it, and only by that one: concurrent orders for the same zone share Let's Encrypt's
   challenge and delete each other's TXT record, so none succeeds. Every other router uses the stored certificate. #}
{% set certificate_requests = namespace(zones=[]) %}
{% macro certificates(hosts, state) %}
{% set requested = namespace(zones=[]) %}
{% for host in hosts %}
{% set labels = host.split('.') %}
{% set zone = host if labels | length == 2 else labels[1:] | join('.') %}
{% if zone not in state.zones and zone not in requested.zones %}
{% set requested.zones = requested.zones + [zone] %}
{% endif %}
{% endfor %}
{% set state.zones = state.zones + requested.zones %}
{% if requested.zones %}
      tls:
        certResolver: letsencrypt
        domains:
{% for zone in requested.zones %}
          - main: {{ zone | to_json }}
            sans:
              - {{ ('*.' ~ zone) | to_json }}
{% endfor %}
{% else %}
      tls: {}
{% endif %}
{% endmacro %}
{% macro host_rule(hosts) %}{{ hosts | map('regex_replace', '^(.*)$', 'Host(`\\1`)') | join(' || ') }}{% endmacro %}
# Rendered from traefik_routes and traefik_redirects in the host's variables
http:
  routers:
{% for route in traefik_routes %}
    {{ route.name | to_json }}:
    {% if route.prefix is defined %}
      rule: {{ ('(' ~ host_rule(route.hosts) ~ ') && PathPrefix(`' ~ route.prefix ~ '`)') | to_json }}
    {% else %}
      rule: {{ host_rule(route.hosts) | to_json }}
    {% endif %}
      entryPoints:
        - web-secure
      service: {{ route.name | to_json }}
  {% if route.internal or route.cloudflare_only | default(false) %}
      middlewares:
    {% if route.internal %}
        - internal-allowlist@file
    {% endif %}
    {% if route.cloudflare_only | default(false) %}
        - cloudflare-only@file
    {% endif %}
  {% endif %}
{{ certificates(route.hosts, certificate_requests) }}
  {% for path in route.paths | default([]) %}
    {{ (route.name ~ '-' ~ loop.index) | to_json }}:
      rule: {{ ('(' ~ host_rule(route.hosts) ~ ') && PathPrefix(`' ~ path.prefix ~ '`)') | to_json }}
      entryPoints:
        - web-secure
    {% if path.redirect is defined %}
      service: noop@internal
    {% else %}
      service: {{ (route.name ~ '-' ~ loop.index) | to_json }}
    {% endif %}
    {% if path.internal | default(route.internal) or route.cloudflare_only | default(false) or path.redirect is defined %}
      middlewares:
      {% if path.internal | default(route.internal) %}
        - internal-allowlist@file
      {% endif %}
      {% if route.cloudflare_only | default(false) %}
        - cloudflare-only@file
      {% endif %}
      {% if path.redirect is defined %}
        - {{ (route.name ~ '-' ~ loop.index ~ '-redirect') | to_json }}
      {% endif %}
    {% endif %}
      tls: {}
  {% endfor %}
{% endfor %}
{% for redirect in traefik_redirects %}
    {{ ('redirect-' ~ redirect.name) | to_json }}:
      rule: {{ host_rule(redirect.hosts) | to_json }}
      entryPoints:
        - web-secure
      service: noop@internal
      middlewares:
  {# Before the redirect, which replies on its own #}
  {% if redirect.cloudflare_only | default(false) %}
        - cloudflare-only@file
  {% endif %}
        - {{ ('redirect-' ~ redirect.name) | to_json }}
{{ certificates(redirect.hosts, certificate_requests) }}
{% endfor %}

  services:
{% for route in traefik_routes %}
    {{ route.name | to_json }}:
      loadBalancer:
        servers:
          - url: {{ route.url | to_json }}
  {% if route.insecure_backend | default(false) %}
        serversTransport: insecure-backend@file
  {% endif %}
  {% for path in route.paths | default([]) %}
    {% if path.url is defined %}
    {{ (route.name ~ '-' ~ loop.index) | to_json }}:
      loadBalancer:
        servers:
          - url: {{ path.url | to_json }}
    {% endif %}
  {% endfor %}
{% endfor %}

  middlewares:
{# Sites proxied by Cloudflare refuse connections that skip it #}
{% set cloudflare_users = (traefik_routes + traefik_redirects) | selectattr('cloudflare_only', 'defined') | selectattr('cloudflare_only') | list %}
{% if cloudflare_users %}
    cloudflare-only:
      ipAllowList:
        sourceRange:
  {% for network in cloudflare_networks %}
          - {{ network | to_json }}
  {% endfor %}
{% endif %}
{% for route in traefik_routes %}
  {% for path in route.paths | default([]) %}
    {% if path.redirect is defined %}
    {{ (route.name ~ '-' ~ loop.index ~ '-redirect') | to_json }}:
      redirectRegex:
        regex: {{ ('^https?://([^/]+)' ~ (path.prefix | regex_escape) ~ '.*') | to_json }}
        replacement: {{ ('https://${1}' ~ path.redirect) | to_json }}
        permanent: true
    {% endif %}
  {% endfor %}
{% endfor %}
{% for redirect in traefik_redirects %}
    {{ ('redirect-' ~ redirect.name) | to_json }}:
      redirectRegex:
        regex: "^https?://[^/]+(.*)"
        replacement: {{ (redirect.to ~ ('${1}' if redirect.preserve_path else '/')) | to_json }}
        permanent: true
{% endfor %}
